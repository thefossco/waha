# Database
DATABASE_URL="postgresql://user:password@localhost:5432/waha_messaging?schema=public"

# Redis for Bull Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Encryption (for API keys storage)
ENCRYPTION_KEY=your-32-character-encryption-key-change-this

# Waha API
WAHA_API_URL=https://api.waha.example
WAHA_API_KEY=your-waha-api-key

# Rate Limiting
WAHA_RATE_LIMIT_PER_MINUTE=60
MAX_BATCH_SIZE=100

# Upload
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads

# Retry Settings
MAX_RETRIES=3
RETRY_BACKOFF_MS=1000

# Callback
CALLBACK_SECRET=your-callback-signature-secret
